generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // اتصال Pooled (يُستخدم في وقت التشغيل داخل Vercel Serverless Functions)
  url       = env("DATABASE_URL")
  // اتصال مباشر (يُستخدم فقط لتشغيل الـ migrations)
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Service {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  shortTitle      String?
  description     String
  fullDescription String         @db.Text
  keywords        String[]       @default([])
  features        String[]       @default([])
  regions         String[]       @default([])
  priority        Int            @default(2)
  coverImage      String?
  coverImageAlt   String?
  metaTitle       String?
  metaDescription String?
  status          ContentStatus  @default(DRAFT)
  order           Int            @default(0)
  deletedAt       DateTime?
  // حقول اختيارية توسّعية — تقابل "article" و"comparison" و"relatedServices"
  // الموجودة أصلاً في lib/data.ts القديم لبعض الخدمات فقط، حُفظت كـ JSON حرة
  // لتجنّب فقدان أي محتوى تسويقي/SEO موجود حاليًا دون الحاجة لجداول إضافية.
  articleBlocks   Json?
  comparisonTable Json?
  relatedServiceIds String[]     @default([])
  images          ServiceImage[]
  faqs            Faq[]
  projects        Project[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, order])
  @@map("services")
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  blobId    String?
  alt       String
  caption   String?
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([serviceId])
  @@map("service_images")
}

model Faq {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question  String
  answer    String  @db.Text
  order     Int     @default(0)

  @@index([serviceId])
  @@map("faqs")
}

model Project {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  summary         String
  description     String         @db.Text
  region          String?
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id])
  coverImage      String
  coverImageAlt   String
  completedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  keywords        String[]       @default([])
  status          ContentStatus  @default(DRAFT)
  deletedAt       DateTime?
  images          ProjectImage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([serviceId])
  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  blobId    String?
  alt       String
  caption   String?
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_images")
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[]

  @@map("categories")
}

model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String
  content         String        @db.Text
  coverImage      String?
  coverImageAlt   String?
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  authorId        String?
  metaTitle       String?
  metaDescription String?
  keywords        String[]      @default([])
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.Text
  rating    Int      @default(5)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
